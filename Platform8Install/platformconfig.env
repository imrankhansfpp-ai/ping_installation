# ==========================================================
# Platform 8 Installation - Environment Configuration
# ==========================================================

# ==========================================================
# REQUIRED USER CONFIGURATION
# ==========================================================
# Change these values to match your environment requirements

# System user that will own and run all Ping platform services
# This user must be created manually before running ./misc/platform8-setup.sh
INSTALL_USER="fradmin"

# ----------------------------------------------------------
# General Script Settings
# ----------------------------------------------------------
SCRIPT_DIR="$(pwd)"
SOFTWARE_DIR="${SCRIPT_DIR}/software"
AM_CONTEXT="am"
DS_REPO_SUFFIX="forgerock.com"

# ----------------------------------------------------------
# Installation Scripts
# ----------------------------------------------------------
DS_SCRIPT="./ds/ds8.sh"
AM_SCRIPT="./am/am8.sh"
AM_FBC_SCRIPT="./am/am8fbc.sh"
IDM_SCRIPT="./idm/idm8.sh"
IG_SCRIPT="./ig/ig8.sh"
IG_NOUI_SCRIPT="./ig/ig8noui.sh"
UI_SCRIPT="./ui/platformui.sh"
AM_REST_SCRIPT="./am/configure_am.sh"

# ----------------------------------------------------------
# Software Versions - REMOVED (now using dynamic detection in each script)
# ----------------------------------------------------------

# ----------------------------------------------------------
# Software Directory Locations
# ----------------------------------------------------------
DS_SOFTWARE_DIR="${SOFTWARE_DIR}/ds"
AM_SOFTWARE_DIR="${SOFTWARE_DIR}/am"
AMSTER_SOFTWARE_DIR="${SOFTWARE_DIR}/am"
IDM_SOFTWARE_DIR="${SOFTWARE_DIR}/idm"
IG_SOFTWARE_DIR="${SOFTWARE_DIR}/ig"
UI_SOFTWARE_DIR="${SOFTWARE_DIR}/ui"
AM_JOURNEYS_DIR="${SCRIPT_DIR}/am/root"

# ----------------------------------------------------------
# Software Files - REMOVED (now using dynamic detection in each script)
# ----------------------------------------------------------
AMSTER_DIR="${AMSTER_SOFTWARE_DIR}/amster"
TOMCAT_VERSION="10.1.46"

# ----------------------------------------------------------
# Installation Directories
# ----------------------------------------------------------
BASE_INSTALL_DIR="/ping"
TOMCAT_DIR="/opt/tomcat"
DS_DIR="${BASE_INSTALL_DIR}/ds"
IDM_DIR="${BASE_INSTALL_DIR}"
IDM_EXTRACT_DIR="${IDM_DIR}/openidm"
IG_DIR="${BASE_INSTALL_DIR}/identity-gateway"
UI_DIR="${TOMCAT_DIR}"

# ----------------------------------------------------------
# Multi-Server & Hostnames Configuration
# For 2-Server Setup:
# Server 1 (Data & IDM Tier): DS (Consolidated), PingIDM
# Server 2 (Access & Edge Tier): Tomcat (AM + UI), PingGateway (IG)
# ----------------------------------------------------------
SERVER1_HOSTNAME="${SERVER1_HOSTNAME:-ds1.example.com}"
SERVER2_HOSTNAME="${SERVER2_HOSTNAME:-platform.example.com}"

DS_HOSTNAME="${DS_HOSTNAME:-$SERVER1_HOSTNAME}"
IDM_HOSTNAME="${IDM_HOSTNAME:-$SERVER1_HOSTNAME}"
AM_HOSTNAME="${AM_HOSTNAME:-am.example.com}"
IG_HOSTNAME="${IG_HOSTNAME:-$SERVER2_HOSTNAME}"
PLATFORM_HOSTNAME="${PLATFORM_HOSTNAME:-$SERVER2_HOSTNAME}"
LOGIN_HOSTNAME="login.example.com"
ADMIN_HOSTNAME="admin.example.com"
ENDUSER_HOSTNAME="enduser.example.com"
CTS_HOSTNAME="${DS_HOSTNAME}"
AMCONFIG_HOSTNAME="${DS_HOSTNAME}"
AMIDMREPO_HOSTNAME="${DS_HOSTNAME}"

# ==========================================================
# SECURITY CONFIGURATION - CHANGE THESE BEFORE PRODUCTION!
# ==========================================================

# Default password used for amadmin user (AM and IDM admin access)
DEFAULT_PASSWORD="password"

# Directory Services admin password (cn=Directory Manager)
DS_ADMIN_PASSWORD="password"

# LDAP bind password for service accounts
LDAP_BIND_PASSWORD="password"

# ----------------------------------------------------------
# Test users — created by Step 9 once everything else is up.
# Users are named testuser1..testuser${TEST_USER_COUNT} with
# password $TEST_USER_PASSWORD. They are written via IDM's
# managed/user endpoint using a client_credentials token from
# the alpha realm's 'idm-provisioning' OAuth2 client (which
# Step 7 creates).
# Set INSTALL_TEST_USERS=false to skip Step 9.
# ----------------------------------------------------------
INSTALL_TEST_USERS=true
TEST_USER_COUNT=5
TEST_USER_PASSWORD='!@34QWer'

# ==========================================================
# INSTALLATION INSTRUCTIONS
# ==========================================================
# To setup your Ping Platform 8 environment:
#
# 1. CREATE USER: Manually create the install user defined above
# 2. CUSTOMIZE: Modify the configuration variables above
# 3. PREREQUISITES: Run './misc/platform8-setup.sh' to setup your server
#    - Installs JDK 21, Tomcat 10, and system dependencies
#    - Creates required directories with proper ownership
#    - Configures host entries and firewall
# 4. INSTALL: Run the main installation script to install Platform 8
#    - Installs DS, AM, IDM, IG, and UI components
#    - Configures SSL certificates and service connections
#
# WARNING: Changing variables below this point may cause installation issues
# ==========================================================

AM_TRUSTSTORE_FOLDER="${BASE_INSTALL_DIR}/${AM_CONTEXT}/security/keystores"
AM_TRUSTSTORE="${AM_TRUSTSTORE_FOLDER}/truststore"
TRUSTSTORE_PASSWORD="changeit"
IG_KEY_DIR="${BASE_INSTALL_DIR}/ig_security"
IG_KEYSTORE_PIN_FILE="${IG_KEY_DIR}/keystore.pin"
IG_KEYSTORE_FILE="${IG_KEY_DIR}/keystore"
IG_CA_CERT_FILE="${IG_KEY_DIR}/ca-cert.pem"
DS_DEPLOYMENT_ID="AX8fkJybs4nP3qfAXN3CMw4BCYspGQ5CBVN1bkVDAOgwVKjG2Wo2ZTs"

# ----------------------------------------------------------
# Directory Services (DS) Specific Configuration
# Consolidated Single DS Instance (All Profiles)
# ----------------------------------------------------------
DS_INSTANCE_DIR="${DS_DIR}/opendj"
DS_IDREPO="${DS_INSTANCE_DIR}"
DS_CONFIG="${DS_INSTANCE_DIR}"
DS_CTS="${DS_INSTANCE_DIR}"

DS_LDAP_PORT=1389
DS_LDAPS_PORT=1636
DS_HTTP_PORT=18081
DS_HTTPS_PORT=18443
DS_ADMIN_CONNECTOR_PORT=14444
DS_IDREPO_DN="ou=identities"
DS_ADMIN_DN="cn=Directory Manager"

# Endpoints pointing to the consolidated single DS instance
DS_IDREPO_SERVER="${DS_HOSTNAME}"
DS_IDREPO_SERVER_LDAP_PORT=${DS_LDAP_PORT}
DS_IDREPO_SERVER_LDAPS_PORT=${DS_LDAPS_PORT}
DS_IDREPO_SERVER_HTTP_PORT=${DS_HTTP_PORT}
DS_IDREPO_SERVER_HTTPS_PORT=${DS_HTTPS_PORT}
DS_IDREPO_SERVER_ADMIN_CONNECTOR_PORT=${DS_ADMIN_CONNECTOR_PORT}

DS_AMCONFIG_SERVER="${DS_HOSTNAME}"
DS_AMCONFIG_SERVER_LDAP_PORT=${DS_LDAP_PORT}
DS_AMCONFIG_SERVER_LDAPS_PORT=${DS_LDAPS_PORT}
DS_AMCONFIG_SERVER_HTTP_PORT=${DS_HTTP_PORT}
DS_AMCONFIG_SERVER_HTTPS_PORT=${DS_HTTPS_PORT}
DS_AMCONFIG_SERVER_ADMIN_CONNECTOR_PORT=${DS_ADMIN_CONNECTOR_PORT}

DS_CTS_SERVER="${DS_HOSTNAME}"
DS_CTS_SERVER_LDAP_PORT=${DS_LDAP_PORT}
DS_CTS_SERVER_LDAPS_PORT=${DS_LDAPS_PORT}
DS_CTS_SERVER_HTTP_PORT=${DS_HTTP_PORT}
DS_CTS_SERVER_HTTPS_PORT=${DS_HTTPS_PORT}
DS_CTS_SERVER_ADMIN_CONNECTOR_PORT=${DS_ADMIN_CONNECTOR_PORT}


# ----------------------------------------------------------
# Access Management (AM) Specific Configuration
# ----------------------------------------------------------
COOKIE_DOMAIN="example.com"
TOMCAT_WEBAPPS_DIR="${TOMCAT_DIR}/webapps"
TOMCAT_BIN_DIR="${TOMCAT_DIR}/bin"
AM_FBC_ENV_FILE="${SCRIPT_DIR}/am/setenv-fbc.sh"
AM_ENV_FILE="${SCRIPT_DIR}/am/setenv.sh"
AM_SETENV="${TOMCAT_BIN_DIR}/setenv.sh"
AM_CFG_DIR="${HOME}/.openamcfg"
AM_DIR="${HOME}/openam"
AM_FBC="${HOME}/${AM_CONTEXT}"
TOMCAT_AM_WAR="${TOMCAT_DIR}/webapps/${AM_CONTEXT}.war"
TOMCAT_HTTP_PORT=8081
AM_URL="http://${AM_HOSTNAME}:${TOMCAT_HTTP_PORT}/${AM_CONTEXT}"

# ----------------------------------------------------------
# Identity Management (IDM) Specific Configuration
# ----------------------------------------------------------
IDM_CONFIG_DIR="${IDM_EXTRACT_DIR}/conf"
IDM_LOGS_DIR="${IDM_EXTRACT_DIR}/logs"
IDM_CERT_FILE="${AM_TRUSTSTORE_FOLDER}/ds-repo-ca-cert.pem"
IDM_TRUSTSTORE="${IDM_EXTRACT_DIR}/security/truststore"
IDM_STOREPASS_FILE="${IDM_EXTRACT_DIR}/security/storepass"
EXTERNAL_REPO_CONFIG="${IDM_EXTRACT_DIR}/db/ds/conf/repo.ds-external.json"
BOOT_FILE="${IDM_EXTRACT_DIR}/resolver/boot.properties"
BOOT_PORT_HTTP=8080
BOOT_PORT_HTTPS=8553
BOOT_PORT_MUTUALAUTH=9444
BOOT_HOST="${IDM_HOSTNAME}"

# ----------------------------------------------------------
# Identity Gateway (IG) Specific Configuration
# ----------------------------------------------------------
DSKEYMGR="${DS_INSTANCE_DIR}/bin/dskeymgr"
IG_CFG_DIR="${HOME}/.openig"
IG_CONFIG="${IG_CFG_DIR}/config"
IG_ROUTES="${IG_CONFIG}/routes"
IG_TMP_DIR="${IG_CFG_DIR}/tmp"
IG_HTTP_PORT=7080
IG_HTTPS_PORT=9443

# ----------------------------------------------------------
# Platform UI Configuration
# ----------------------------------------------------------
# UI_ZIP - REMOVED (now using dynamic detection in ui script)
TMP_ROOT="${UI_SOFTWARE_DIR}/tmp"
TMP_UI="${TMP_ROOT}/ui-zip"
WEBAPPS_DIR="${TOMCAT_DIR}/webapps"
SECURE_XUI_DIR="${WEBAPPS_DIR}/${AM_CONTEXT}/XUI"
LOGIN_PORT=8083
ADMIN_PORT=8082
ENDUSER_PORT=8888
